// getSecretValue retrieves a value from a Kubernetes secret.
func getSecretValue(ctx context.Context, kube client.Client, namespace string, selector *esv1.SecretKeySelector) (string, error) {
	secret := &corev1.Secret{}
	ref := client.ObjectKey{
		Namespace: namespace,
		Name:      selector.Name,
	}

	err := kube.Get(ctx, ref, secret)
	if err != nil {
		return "", fmt.Errorf("failed to get secret %s: %w", selector.Name, err)
	}

	value, ok := secret.Data[selector.Key]
	if !ok {
		return "", fmt.Errorf("key %s not found in secret %s", selector.Key, selector.Name)
	}

	return string(value), nil
}
