func TestValidateStore(t *testing.T) {
	tests := []struct {
		name      string
		store     *esv1.SecretStore
		wantErr   bool
		errString string
	}{
		{
			name: "valid configuration",
			store: &esv1.SecretStore{
				Spec: esv1.SecretStoreSpec{
					Provider: &esv1.SecretStoreProvider{
						{{.ProviderName}}: &esv1.{{.ProviderName}}Provider{
							// TODO: Add valid configuration fields
						},
					},
				},
			},
			wantErr: false,
		},
		{
			name: "missing provider configuration",
			store: &esv1.SecretStore{
				Spec: esv1.SecretStoreSpec{
					Provider: &esv1.SecretStoreProvider{},
				},
			},
			wantErr:   true,
			errString: errMissing{{.ProviderName}}Config,
		},
		// TODO: Add more test cases for various validation scenarios
	}

	p := &Provider{}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			_, err := p.ValidateStore(tt.store)
			if tt.wantErr {
				assert.Error(t, err)
				if tt.errString != "" {
					assert.Contains(t, err.Error(), tt.errString)
				}
			} else {
				assert.NoError(t, err)
			}
		})
	}
}

func TestNewClient(t *testing.T) {
	tests := []struct {
		name      string
		store     *esv1.SecretStore
		namespace string
		wantErr   bool
	}{
		{
			name: "successful client creation",
			store: &esv1.SecretStore{
				ObjectMeta: metav1.ObjectMeta{
					Name:      "test-store",
					Namespace: "default",
				},
				Spec: esv1.SecretStoreSpec{
					Provider: &esv1.SecretStoreProvider{
						{{.ProviderName}}: &esv1.{{.ProviderName}}Provider{
							// TODO: Add valid configuration
						},
					},
				},
			},
			namespace: "default",
			wantErr:   false,
		},
		{
			name: "missing configuration",
			store: &esv1.SecretStore{
				ObjectMeta: metav1.ObjectMeta{
					Name:      "test-store",
					Namespace: "default",
				},
				Spec: esv1.SecretStoreSpec{
					Provider: &esv1.SecretStoreProvider{},
				},
			},
			namespace: "default",
			wantErr:   true,
		},
		// TODO: Add more test cases
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			p := &Provider{}
			kube := fake.NewClientBuilder().Build()
			ctx := context.Background()

			client, err := p.NewClient(ctx, tt.store, kube, tt.namespace)
			if tt.wantErr {
				assert.Error(t, err)
				assert.Nil(t, client)
			} else {
				assert.NoError(t, err)
				assert.NotNil(t, client)
			}
		})
	}
}

